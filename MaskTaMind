<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mask他／她 Mind</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Microsoft JhengHei', 'PingFang TC', sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow-x: hidden;
        }

        .game-container {
            background: #fafafa;
            border-radius: 20px;
            padding: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
            max-width: 1100px;
            width: 95%;
        }

        .header {
            text-align: center;
            margin-bottom: 15px;
        }

        .header h1 {
            font-size: 1.8em;
            background: linear-gradient(135deg, #ff6b9d 0%, #c44569 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stats {
            display: flex;
            justify-content: center;
            gap: 25px;
            margin-bottom: 15px;
            padding: 12px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
        }

        .stat-item {
            text-align: center;
            color: white;
        }

        .stat-item .label { font-size: 0.75em; opacity: 0.9; }
        .stat-item .value { font-size: 1.4em; font-weight: bold; }

        .main-area {
            display: flex;
            gap: 25px;
            align-items: flex-start;
        }

        .character-section {
            flex: 1.2;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .character-frame {
            position: relative;
            width: 320px;
            height: 420px;
            background: #f5f5f5;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            border: 3px solid #333;
        }

        .hint-btn {
            margin-top: 12px;
            padding: 10px 25px;
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            font-size: 0.9em;
            font-weight: bold;
            transition: all 0.3s;
        }

        .hint-btn:hover:not(:disabled) { transform: translateY(-2px); }
        .hint-btn:disabled { background: #999; cursor: not-allowed; }

        .options-section {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .options-title {
            text-align: center;
            font-size: 1em;
            color: #555;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .option-btn {
            padding: 8px;
            background: white;
            border: 3px solid #ddd;
            border-radius: 15px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .option-btn:hover:not(:disabled) {
            border-color: #ff6b9d;
            transform: scale(1.02);
        }

        .option-btn:disabled { opacity: 0.6; cursor: not-allowed; }
        .option-btn.correct { border-color: #2ecc71; background: #e8f8f0; }
        .option-btn.wrong { border-color: #e74c3c; background: #fdf2f2; }

        .option-face {
            width: 100%;
            height: 110px;
            border-radius: 10px;
            overflow: hidden;
        }

        .overlay {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.9);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 100;
        }

        .overlay.show { display: flex; }

        .modal {
            background: white;
            padding: 25px 35px;
            border-radius: 20px;
            text-align: center;
            max-width: 750px;
            width: 92%;
            animation: modalPop 0.4s ease-out;
        }

        @keyframes modalPop {
            0% { transform: scale(0.7); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        .result-title { font-size: 1.6em; margin-bottom: 15px; }
        .result-title.correct { color: #27ae60; }
        .result-title.wrong { color: #e74c3c; }

        .comparison-area {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin: 15px 0;
            align-items: center;
            flex-wrap: wrap;
        }

        .face-preview { text-align: center; }
        .face-preview .label { font-size: 0.9em; color: #666; margin-bottom: 6px; font-weight: bold; }

        .face-box {
            width: 200px;
            height: 260px;
            border-radius: 15px;
            overflow: hidden;
            border: 3px solid #333;
        }

        .face-box.selected { border-color: #3498db; }
        .face-box.real { border-color: #2ecc71; }

        .vs-icon { font-size: 2em; margin: 0 8px; color: #888; }

        .score-result { font-size: 1.3em; font-weight: bold; margin: 12px 0; }
        .score-result.positive { color: #27ae60; }
        .score-result.negative { color: #e74c3c; }

        .btn-primary {
            padding: 12px 40px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            font-size: 1em;
            font-weight: bold;
            transition: all 0.3s;
        }

        .btn-primary:hover { transform: scale(1.05); }

        .btn-start {
            background: linear-gradient(135deg, #ff6b9d 0%, #c44569 100%);
        }

        .start-overlay { z-index: 200; display: flex; }
        .start-overlay.hide { display: none; }

        .start-content p {
            font-size: 0.95em;
            color: #555;
            line-height: 1.9;
            margin: 15px 0;
        }

        .rank-badge {
            width: 90px; height: 90px;
            margin: 12px auto;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .rank-badge.gold { background: linear-gradient(135deg, #ffd700, #ffaa00); box-shadow: 0 0 30px rgba(255,215,0,0.5); }
        .rank-badge.silver { background: linear-gradient(135deg, #e8e8e8, #b8b8b8); }
        .rank-badge.bronze { background: linear-gradient(135deg, #cd7f32, #a0522d); }
        .rank-badge.iron { background: linear-gradient(135deg, #888, #666); }

        .final-msg { font-size: 1.2em; color: #444; margin: 12px 0; }
        .final-stats { font-size: 0.95em; color: #666; margin-bottom: 15px; line-height: 1.7; }

        @media (max-width: 850px) {
            .main-area { flex-direction: column; align-items: center; }
            .character-frame { width: 280px; height: 370px; }
            .options-section { width: 100%; flex-direction: row; flex-wrap: wrap; justify-content: center; }
            .option-btn { width: calc(33% - 8px); }
            .option-face { height: 85px; }
            .comparison-area { flex-direction: column; }
            .face-box { width: 160px; height: 210px; }
        }
    </style>
</head>
<body>
    <!-- Start Screen -->
    <div class="overlay start-overlay" id="startScreen">
        <div class="modal">
            <h1 style="font-size: 2em; background: linear-gradient(135deg, #ff6b9d, #c44569); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Mask他／她 Mind</h1>
            <div id="startIcon" style="margin: 15px 0;"></div>
            <p>
                🎭 觀察角色的眼神、髮型、氣質<br>
                猜猜口罩下的真實面容！<br><br>
                ⚠️ <strong>小心！選項中有搞笑陷阱！</strong><br>
                美女配大叔鬍渣？帥哥配厚唇？<br><br>
                <strong>猜對 +100 ・ 猜錯 -20 ・ 提示 -10</strong>
            </p>
            <button class="btn-primary btn-start" onclick="startGame()">開始遊戲</button>
        </div>
    </div>

    <!-- Main Game -->
    <div class="game-container">
        <div class="header">
            <h1>Mask他／她 Mind</h1>
        </div>

        <div class="stats">
            <div class="stat-item">
                <div class="label">分數</div>
                <div class="value" id="scoreDisplay">0</div>
            </div>
            <div class="stat-item">
                <div class="label">題目</div>
                <div class="value"><span id="questionNum">1</span>/12</div>
            </div>
            <div class="stat-item">
                <div class="label">答對</div>
                <div class="value" id="correctDisplay">0</div>
            </div>
        </div>

        <div class="main-area">
            <div class="character-section">
                <div class="character-frame" id="characterFrame"></div>
                <button class="hint-btn" id="hintBtn" onclick="revealHint()">💡 提示 (-10分)</button>
            </div>

            <div class="options-section">
                <div class="options-title">👇 選擇口罩下的真面目</div>
                <button class="option-btn" id="option0" onclick="pickOption(0)">
                    <div class="option-face" id="optionFace0"></div>
                </button>
                <button class="option-btn" id="option1" onclick="pickOption(1)">
                    <div class="option-face" id="optionFace1"></div>
                </button>
                <button class="option-btn" id="option2" onclick="pickOption(2)">
                    <div class="option-face" id="optionFace2"></div>
                </button>
            </div>
        </div>
    </div>

    <!-- Result Modal -->
    <div class="overlay" id="resultScreen">
        <div class="modal">
            <h2 class="result-title" id="resultTitle"></h2>
            <div class="comparison-area">
                <div class="face-preview">
                    <div class="label">你的選擇</div>
                    <div class="face-box selected" id="chosenFace"></div>
                </div>
                <div class="vs-icon" id="vsIcon"></div>
                <div class="face-preview">
                    <div class="label">正確答案</div>
                    <div class="face-box real" id="correctFace"></div>
                </div>
            </div>
            <div class="score-result" id="scoreResult"></div>
            <button class="btn-primary" onclick="nextRound()">下一題 →</button>
        </div>
    </div>

    <!-- Final Screen -->
    <div class="overlay" id="finalScreen">
        <div class="modal">
            <h1 style="font-size: 1.8em; background: linear-gradient(135deg, #ff6b9d, #c44569); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">遊戲結束！</h1>
            <div class="rank-badge" id="rankBadge"></div>
            <div class="final-msg" id="finalMsg"></div>
            <div class="final-stats">
                最終分數：<strong id="finalScore"></strong><br>
                答對題數：<strong id="finalCorrect"></strong> / 12
            </div>
            <button class="btn-primary btn-start" onclick="restartGame()">再玩一次</button>
        </div>
    </div>

    <script>
