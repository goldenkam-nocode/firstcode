                              fill="url(#hairGrad)" stroke="#333" stroke-width="2"/>
                        <path d="M250 170 Q270 200 265 280 Q262 340 250 380 Q245 340 240 280 Q235 220 245 175" 
                              fill="url(#hairGrad)" stroke="#333" stroke-width="2"/>
                    `;
                case 'long_straight':
                    return `
                        <ellipse cx="160" cy="140" rx="85" ry="70" fill="url(#hairGrad)" stroke="#333" stroke-width="2"/>
                        <rect x="75" y="140" width="40" height="220" rx="20" fill="url(#hairGrad)" stroke="#333" stroke-width="2"/>
                        <rect x="205" y="140" width="40" height="220" rx="20" fill="url(#hairGrad)" stroke="#333" stroke-width="2"/>
                    `;
                case 'drills':
                    return `
                        <ellipse cx="160" cy="138" rx="88" ry="68" fill="url(#hairGrad)" stroke="#333" stroke-width="2"/>
                        <ellipse cx="65" cy="200" rx="28" ry="40" fill="url(#hairGrad)" stroke="#333" stroke-width="2"/>
                        <ellipse cx="65" cy="260" rx="22" ry="35" fill="url(#hairGrad)" stroke="#333" stroke-width="2"/>
                        <ellipse cx="65" cy="315" rx="16" ry="28" fill="url(#hairGrad)" stroke="#333" stroke-width="2"/>
                        <ellipse cx="255" cy="200" rx="28" ry="40" fill="url(#hairGrad)" stroke="#333" stroke-width="2"/>
                        <ellipse cx="255" cy="260" rx="22" ry="35" fill="url(#hairGrad)" stroke="#333" stroke-width="2"/>
                        <ellipse cx="255" cy="315" rx="16" ry="28" fill="url(#hairGrad)" stroke="#333" stroke-width="2"/>
                    `;
                case 'messy_short':
                case 'spiky':
                case 'wild':
                    return `<ellipse cx="160" cy="130" rx="80" ry="60" fill="url(#hairGrad)" stroke="#333" stroke-width="2"/>`;
                case 'short_bob':
                    return `
