                             Q95 240 92 220 
                             Q90 205 95 200" 
                          stroke="#87CEEB" stroke-width="4" fill="none" stroke-linecap="round"/>
                    
                    <!-- 右耳掛繩 - 從口罩邊緣到耳朵 -->
