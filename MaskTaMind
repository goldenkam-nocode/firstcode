            { id: 'zombie', name: '喪屍嘴', gender: 'n' }
        ];

        function renderCharacter(char, maskOffset = 0) {
            return `
            <svg viewBox="0 0 320 420" width="100%" height="100%">
                <defs>
                    <linearGradient id="skinGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="${char.skinTone}"/>
                        <stop offset="100%" stop-color="${adjustColor(char.skinTone, -20)}"/>
                    </linearGradient>
                    <linearGradient id="hairGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="${char.hairHighlight}"/>
                        <stop offset="50%" stop-color="${char.hairColor}"/>
                        <stop offset="100%" stop-color="${adjustColor(char.hairColor, -30)}"/>
                    </linearGradient>
                </defs>
                
                <rect width="320" height="420" fill="${char.gender === 'f' ? '#FFF5F8' : '#F5F8FF'}"/>
                
                ${char.gender === 'f' ? `
                    <circle cx="40" cy="50" r="4" fill="#FFB0C8" opacity="0.5"/>
                    <circle cx="280" cy="70" r="3" fill="#FFB0C8" opacity="0.4"/>
                    <circle cx="50" cy="380" r="5" fill="#FFB0C8" opacity="0.3"/>
                ` : ''}
                
                ${renderHairBack(char)}
                
                <path d="M130 310 L130 360 Q130 380 160 380 Q190 380 190 360 L190 310" 
                      fill="url(#skinGrad)" stroke="#333" stroke-width="2"/>
                
                ${renderCollar(char)}
                
                <path d="M100 200 
                         Q90 160 105 125 
                         Q125 95 160 92 
                         Q195 95 215 125 
                         Q230 160 220 200 
                         Q225 240 205 275 
                         Q180 310 160 315 
                         Q140 310 115 275 
                         Q95 240 100 200" 
                      fill="url(#skinGrad)" stroke="#333" stroke-width="2.5"/>
                
                <!-- 耳朵 -->
                <ellipse cx="95" cy="200" rx="12" ry="20" fill="${char.skinTone}" stroke="#333" stroke-width="2"/>
                <ellipse cx="225" cy="200" rx="12" ry="20" fill="${char.skinTone}" stroke="#333" stroke-width="2"/>
                
                ${renderHairFront(char)}
                ${renderEyebrows(char)}
                ${renderEyes(char)}
                
                ${char.blush ? `
                    <ellipse cx="115" cy="230" rx="20" ry="8" fill="#FF8888" opacity="0.35"/>
                    <ellipse cx="205" cy="230" rx="20" ry="8" fill="#FF8888" opacity="0.35"/>
                ` : ''}
                
                ${renderAccessories(char)}
                
                <!-- 口罩 - 耳掛正確連接到耳朵 -->
                <g transform="translate(0, ${maskOffset})">
                    <!-- 左耳掛繩 - 從口罩邊緣到耳朵 -->
