                        <path d="M${cx-18} ${cy} Q${cx} ${cy+8} ${cx+18} ${cy}" stroke="#8B7355" stroke-width="3" fill="none" stroke-linecap="round"/>
                        <ellipse cx="${cx}" cy="${cy+15}" rx="12" ry="8" fill="#D2B48C" opacity="0.3"/>
                    `;
                case 'thick_lips':
                    return `
                        <ellipse cx="${cx}" cy="${cy-5}" rx="28" ry="12" fill="#CD5C5C"/>
                        <ellipse cx="${cx}" cy="${cy+10}" rx="32" ry="15" fill="#B22222"/>
                        <ellipse cx="${cx}" cy="${cy}" rx="8" ry="4" fill="#1a1a1a"/>
                        <ellipse cx="${cx-10}" cy="${cy-8}" rx="8" ry="4" fill="white" opacity="0.4"/>
                    `;
                case 'old_man':
                    return `
                        <path d="M${cx-25} ${cy-15} Q${cx-20} ${cy-10} ${cx-25} ${cy-5}" stroke="#999" stroke-width="1.5" fill="none"/>
                        <path d="M${cx+25} ${cy-15} Q${cx+20} ${cy-10} ${cx+25} ${cy-5}" stroke="#999" stroke-width="1.5" fill="none"/>
                        <path d="M${cx-22} ${cy+5} Q${cx-18} ${cy+10} ${cx-22} ${cy+15}" stroke="#999" stroke-width="1.5" fill="none"/>
                        <path d="M${cx+22} ${cy+5} Q${cx+18} ${cy+10} ${cx+22} ${cy+15}" stroke="#999" stroke-width="1.5" fill="none"/>
                        <path d="M${cx-15} ${cy} Q${cx} ${cy-5} ${cx+15} ${cy}" stroke="#8B7355" stroke-width="2" fill="none"/>
                        <path d="M${cx-12} ${cy+3} Q${cx} ${cy+8} ${cx+12} ${cy+3}" stroke="#8B7355" stroke-width="1.5" fill="none"/>
                    `;
                case 'drool':
                    return `
                        <path d="M${cx-20} ${cy-5} Q${cx} ${cy+15} ${cx+20} ${cy-5}" fill="#E57373"/>
                        <path d="M${cx-15} ${cy-2} Q${cx} ${cy-8} ${cx+15} ${cy-2}" fill="white"/>
                        <ellipse cx="${cx}" cy="${cy+5}" rx="5" ry="3" fill="#1a1a1a"/>
                        <path d="M${cx+8} ${cy+10} Q${cx+12} ${cy+30} ${cx+6} ${cy+45}" fill="#87CEEB" opacity="0.7"/>
                        <ellipse cx="${cx+7}" cy="${cy+48}" rx="6" ry="4" fill="#87CEEB" opacity="0.5"/>
                    `;
                case 'missing_tooth':
                    return `
                        <path d="M${cx-25} ${cy-8} Q${cx} ${cy+20} ${cx+25} ${cy-8}" fill="#E57373"/>
                        <path d="M${cx-20} ${cy-5} Q${cx} ${cy-12} ${cx+20} ${cy-5}" fill="white"/>
                        <rect x="${cx-18}" y="${cy-5}" width="8" height="10" fill="white" stroke="#ddd" stroke-width="0.5"/>
                        <rect x="${cx-8}" y="${cy-5}" width="8" height="10" fill="#1a1a1a"/>
                        <rect x="${cx+2}" y="${cy-5}" width="8" height="10" fill="white" stroke="#ddd" stroke-width="0.5"/>
                        <rect x="${cx+12}" y="${cy-5}" width="8" height="10" fill="white" stroke="#ddd" stroke-width="0.5"/>
                    `;
                case 'beard_full':
                    return `
                        <path d="M${cx-35} ${cy-20} 
                                 Q${cx-40} ${cy+30} ${cx} ${cy+45} 
                                 Q${cx+40} ${cy+30} ${cx+35} ${cy-20}" 
                              fill="#4a3728" stroke="#333" stroke-width="1.5"/>
                        <path d="M${cx-30} ${cy-15} Q${cx-20} ${cy-5} ${cx-25} ${cy+10}" stroke="#5a4738" stroke-width="2" fill="none"/>
                        <path d="M${cx+30} ${cy-15} Q${cx+20} ${cy-5} ${cx+25} ${cy+10}" stroke="#5a4738" stroke-width="2" fill="none"/>
                        <path d="M${cx-15} ${cy-18} Q${cx} ${cy-25} ${cx+15} ${cy-18}" stroke="#8B7355" stroke-width="2" fill="none"/>
                    `;
                case 'lipstick_mess':
                    return `
                        <ellipse cx="${cx-15}" cy="${cy-10}" rx="12" ry="8" fill="#FF1493" opacity="0.6" transform="rotate(-20 ${cx-15} ${cy-10})"/>
                        <ellipse cx="${cx+18}" cy="${cy-5}" rx="10" ry="6" fill="#FF1493" opacity="0.5" transform="rotate(15 ${cx+18} ${cy-5})"/>
                        <ellipse cx="${cx-8}" cy="${cy+15}" rx="8" ry="5" fill="#FF1493" opacity="0.4"/>
                        <path d="M${cx-18} ${cy} Q${cx} ${cy+12} ${cx+18} ${cy}" fill="#FF1493"/>
                        <path d="M${cx-15} ${cy-3} Q${cx} ${cy-10} ${cx+15} ${cy-3}" fill="#FF69B4"/>
                    `;
                case 'duck_lips':
                    return `
                        <ellipse cx="${cx}" cy="${cy}" rx="20" ry="25" fill="#FFB6C1"/>
                        <ellipse cx="${cx}" cy="${cy-8}" rx="18" ry="10" fill="#FFC0CB"/>
                        <ellipse cx="${cx}" cy="${cy+10}" rx="22" ry="12" fill="#FF69B4"/>
                        <path d="M${cx-5} ${cy} L${cx+5} ${cy}" stroke="#333" stroke-width="2"/>
                        <circle cx="${cx-8}" cy="${cy-5}" r="4" fill="white" opacity="0.5"/>
                    `;
                case 'grandma':
                    return `
                        <path d="M${cx-20} ${cy-5} Q${cx} ${cy+5} ${cx+20} ${cy-5}" stroke="#999" stroke-width="2" fill="none"/>
                        <path d="M${cx-15} ${cy+5} Q${cx} ${cy+12} ${cx+15} ${cy+5}" stroke="#999" stroke-width="1.5" fill="none"/>
                        <path d="M${cx-25} ${cy-10} L${cx-20} ${cy-5}" stroke="#aaa" stroke-width="1"/>
                        <path d="M${cx+25} ${cy-10} L${cx+20} ${cy-5}" stroke="#aaa" stroke-width="1"/>
                        <path d="M${cx-28} ${cy} L${cx-22} ${cy+2}" stroke="#aaa" stroke-width="1"/>
                        <path d="M${cx+28} ${cy} L${cx+22} ${cy+2}" stroke="#aaa" stroke-width="1"/>
                    `;
                case 'zombie':
                    return `
                        <path d="M${cx-28} ${cy-5} Q${cx} ${cy+20} ${cx+28} ${cy-5}" fill="#556B2F"/>
                        <rect x="${cx-22}" y="${cy-5}" width="7" height="12" fill="#FFFACD" transform="rotate(-10 ${cx-18} ${cy})"/>
                        <rect x="${cx-8}" y="${cy-5}" width="6" height="10" fill="#FFFACD" transform="rotate(5 ${cx-5} ${cy})"/>
                        <rect x="${cx+8}" y="${cy-5}" width="7" height="11" fill="#FFFACD" transform="rotate(-8 ${cx+11} ${cy})"/>
                        <rect x="${cx+18}" y="${cy-5}" width="6" height="9" fill="#FFFACD" transform="rotate(12 ${cx+21} ${cy})"/>
                        <path d="M${cx+15} ${cy+8} Q${cx+18} ${cy+18} ${cx+12} ${cy+25}" fill="#8B0000" opacity="0.7"/>
                    `;
                default:
                    return renderNormalMouth('gentle_smile', cx, cy, 'f');
            }
        }

        function renderNormalMouth(type, cx, cy, gender) {
            const lipColor = gender === 'f' ? '#E57373' : '#CD8B8B';
            
            switch(type) {
                case 'cute_smile':
                    return `
                        <path d="M${cx-15} ${cy} Q${cx} ${cy+15} ${cx+15} ${cy}" fill="${lipColor}"/>
                        <path d="M${cx-12} ${cy+2} Q${cx} ${cy-5} ${cx+12} ${cy+2}" fill="white"/>
                    `;
                case 'gentle_smile':
                    return `
                        <path d="M${cx-18} ${cy} Q${cx} ${cy+12} ${cx+18} ${cy}" stroke="${lipColor}" stroke-width="3" fill="none" stroke-linecap="round"/>
                    `;
                case 'pout':
                    return `
                        <ellipse cx="${cx}" cy="${cy+3}" rx="12" ry="8" fill="#FFB6C1"/>
                        <path d="M${cx-10} ${cy} Q${cx} ${cy-5} ${cx+10} ${cy}" stroke="${lipColor}" stroke-width="2.5" fill="none"/>
                    `;
                case 'smirk':
                    return `
                        <path d="M${cx-15} ${cy+3} Q${cx} ${cy-5} ${cx+18} ${cy-8}" stroke="${lipColor}" stroke-width="3" fill="none" stroke-linecap="round"/>
                    `;
                case 'big_grin':
                    return `
                        <path d="M${cx-22} ${cy-5} Q${cx} ${cy+20} ${cx+22} ${cy-5}" fill="${lipColor}"/>
                        <path d="M${cx-18} ${cy-2} Q${cx} ${cy-10} ${cx+18} ${cy-2}" fill="white"/>
                    `;
                case 'flat_line':
                    return `
                        <line x1="${cx-15}" y1="${cy}" x2="${cx+15}" y2="${cy}" stroke="${lipColor}" stroke-width="3" stroke-linecap="round"/>
                    `;
                case 'cat_smile':
                    return `
                        <path d="M${cx-18} ${cy} Q${cx-10} ${cy-8} ${cx} ${cy+5} Q${cx+10} ${cy-8} ${cx+18} ${cy}" stroke="${lipColor}" stroke-width="3" fill="none" stroke-linecap="round"/>
                    `;
                case 'fanged_grin':
                    return `
                        <path d="M${cx-20} ${cy-5} Q${cx} ${cy+18} ${cx+20} ${cy-5}" fill="${lipColor}"/>
                        <path d="M${cx-16} ${cy-2} Q${cx} ${cy-8} ${cx+16} ${cy-2}" fill="white"/>
                        <path d="M${cx-10} ${cy-2} L${cx-8} ${cy+10} L${cx-6} ${cy-2}" fill="white"/>
                        <path d="M${cx+6} ${cy-2} L${cx+8} ${cy+10} L${cx+10} ${cy-2}" fill="white"/>
                    `;
                case 'sweet_smile':
                    return `
                        <path d="M${cx-16} ${cy} Q${cx} ${cy+14} ${cx+16} ${cy}" fill="${lipColor}"/>
                        <path d="M${cx-13} ${cy+2} Q${cx} ${cy-5} ${cx+13} ${cy+2}" fill="white"/>
                    `;
                case 'charming_smile':
                    return `
                        <path d="M${cx-20} ${cy-3} Q${cx} ${cy+15} ${cx+20} ${cy-3}" fill="${lipColor}"/>
                        <path d="M${cx-16} ${cy} Q${cx} ${cy-7} ${cx+16} ${cy}" fill="white"/>
                    `;
                case 'elegant_smile':
                    return `
                        <path d="M${cx-16} ${cy} Q${cx} ${cy+10} ${cx+16} ${cy}" stroke="${lipColor}" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                    `;
                default:
                    return `
                        <path d="M${cx-15} ${cy} Q${cx} ${cy+12} ${cx+15} ${cy}" stroke="${lipColor}" stroke-width="3" fill="none" stroke-linecap="round"/>
                    `;
            }
        }

        function generateStubble(cx, cy) {
            let stubble = '';
            for (let i = 0; i < 40; i++) {
                const x = cx - 30 + Math.random() * 60;
                const y = cy - 15 + Math.random() * 40;
                const r = 0.8 + Math.random() * 1;
                stubble += `<circle cx="${x}" cy="${y}" r="${r}"/>`;
            }
            return stubble;
        }

        function renderComparisonFace(char, mouthData, isCorrect) {
            return `
            <svg viewBox="0 0 200 260" width="100%" height="100%">
                <defs>
                    <linearGradient id="cSkin" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="${char.skinTone}"/>
                        <stop offset="100%" stop-color="${adjustColor(char.skinTone, -20)}"/>
                    </linearGradient>
                    <linearGradient id="cHair" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="${char.hairHighlight}"/>
                        <stop offset="50%" stop-color="${char.hairColor}"/>
                        <stop offset="100%" stop-color="${adjustColor(char.hairColor, -30)}"/>
                    </linearGradient>
                </defs>
                
                <rect width="200" height="260" fill="${char.gender === 'f' ? '#FFF5F8' : '#F5F8FF'}"/>
                
                <ellipse cx="100" cy="80" rx="60" ry="50" fill="url(#cHair)" stroke="#333" stroke-width="2"/>
                
                <path d="M50 120 Q45 90 55 70 Q75 50 100 48 Q125 50 145 70 Q155 90 150 120 Q155 155 135 180 Q115 205 100 208 Q85 205 65 180 Q45 155 50 120" 
                      fill="url(#cSkin)" stroke="#333" stroke-width="2"/>
                
                <path d="M45 85 Q75 55 100 52 Q125 55 155 85 Q125 105 100 100 Q75 105 45 85" 
                      fill="url(#cHair)" stroke="#333" stroke-width="2"/>
                
                <ellipse cx="75" cy="120" rx="15" ry="15" fill="white" stroke="#333" stroke-width="1.5"/>
                <ellipse cx="76" cy="122" rx="10" ry="11" fill="${char.eyeColor}"/>
                <circle cx="76" cy="124" r="5" fill="${adjustColor(char.eyeColor, -40)}"/>
                <circle cx="72" cy="118" r="4" fill="white"/>
                
                <ellipse cx="125" cy="120" rx="15" ry="15" fill="white" stroke="#333" stroke-width="1.5"/>
                <ellipse cx="124" cy="122" rx="10" ry="11" fill="${char.eyeColor}"/>
                <circle cx="124" cy="124" r="5" fill="${adjustColor(char.eyeColor, -40)}"/>
                <circle cx="120" cy="118" r="4" fill="white"/>
                
                ${char.blush ? `
                    <ellipse cx="65" cy="140" rx="12" ry="5" fill="#FF8888" opacity="0.35"/>
                    <ellipse cx="135" cy="140" rx="12" ry="5" fill="#FF8888" opacity="0.35"/>
                ` : ''}
                
                <path d="M100 145 L103 165 L97 165 Z" fill="${adjustColor(char.skinTone, -15)}" opacity="0.5" stroke="#333" stroke-width="0.5"/>
                
                <g transform="translate(10, 110)">
                    ${isCorrect ? 
                        renderNormalMouth(char.correctMouth, 90, 75, char.gender) : 
                        renderMouthOption(mouthData, false, char)}
                </g>
            </svg>`;
        }

        function adjustColor(hex, amount) {
            const num = parseInt(hex.replace('#', ''), 16);
            const r = Math.min(255, Math.max(0, (num >> 16) + amount));
            const g = Math.min(255, Math.max(0, ((num >> 8) & 0x00FF) + amount));
            const b = Math.min(255, Math.max(0, (num & 0x0000FF) + amount));
            return `#${(1 << 24 | r << 16 | g << 8 | b).toString(16).slice(1)}`;
        }

        function initGame() {
            gameState.questions = [...characters].sort(() => Math.random() - 0.5);
        }

        function loadRound() {
            if (gameState.round >= 12) {
                showFinal();
                return;
            }

            gameState.hintLevel = 0;
            gameState.currentChar = gameState.questions[gameState.round];
            
            document.getElementById('characterFrame').innerHTML = renderCharacter(gameState.currentChar, 0);
            
            const shuffledFunny = [...funnyMouths].sort(() => Math.random() - 0.5);
            const wrongOptions = shuffledFunny.slice(0, 2);
            
            const allOptions = [
                { ...{ id: 'correct', name: '正確' }, isCorrect: true },
                { ...wrongOptions[0], isCorrect: false },
                { ...wrongOptions[1], isCorrect: false }
            ].sort(() => Math.random() - 0.5);
            
            gameState.currentChar.options = allOptions;
            gameState.currentChar.correctIdx = allOptions.findIndex(o => o.isCorrect);
            
            allOptions.forEach((opt, i) => {
                document.getElementById(`optionFace${i}`).innerHTML = renderOptionFace(gameState.currentChar, opt, opt.isCorrect);
                const btn = document.getElementById(`option${i}`);
                btn.className = 'option-btn';
                btn.disabled = false;
            });
            
            updateHintBtn();
            document.getElementById('questionNum').textContent = gameState.round + 1;
        }

        function pickOption(idx) {
            document.querySelectorAll('.option-btn').forEach(b => b.disabled = true);
            
            const opt = gameState.currentChar.options[idx];
            const correct = opt.isCorrect;
            
            document.getElementById(`option${idx}`).classList.add(correct ? 'correct' : 'wrong');
            if (!correct) {
                document.getElementById(`option${gameState.currentChar.correctIdx}`).classList.add('correct');
            }
            
            if (correct) {
                gameState.score += 100;
                gameState.correct++;
            } else {
                gameState.score = Math.max(0, gameState.score - 20);
            }
            
            updateDisplay();
            setTimeout(() => showResult(opt, correct, idx), 400);
        }

        function showResult(opt, correct, chosenIdx) {
            const screen = document.getElementById('resultScreen');
            const title = document.getElementById('resultTitle');
            
            title.className = 'result-title ' + (correct ? 'correct' : 'wrong');
            title.textContent = correct ? '🎉 答對了！' : `😅 是${opt.name}啦！`;
            
            document.getElementById('chosenFace').innerHTML = renderComparisonFace(gameState.currentChar, opt, opt.isCorrect);
            document.getElementById('correctFace').innerHTML = renderComparisonFace(gameState.currentChar, { id: 'correct' }, true);
            
            document.getElementById('vsIcon').textContent = correct ? '✓' : '✗';
            document.getElementById('vsIcon').style.color = correct ? '#2ecc71' : '#e74c3c';
            
            const scoreEl = document.getElementById('scoreResult');
            scoreEl.className = 'score-result ' + (correct ? 'positive' : 'negative');
            scoreEl.textContent = correct ? '+100 分' : '-20 分';
            
            screen.classList.add('show');
        }

        function revealHint() {
            if (gameState.score >= 10 && gameState.hintLevel < 3) {
                gameState.score -= 10;
                gameState.hintLevel++;
                updateDisplay();
                document.getElementById('characterFrame').innerHTML = renderCharacter(gameState.currentChar, gameState.hintLevel * 25);
                updateHintBtn();
            }
        }

        function updateHintBtn() {
            const btn = document.getElementById('hintBtn');
            if (gameState.score < 10) {
                btn.disabled = true;
                btn.textContent = '💡 分數不足';
            } else if (gameState.hintLevel >= 3) {
                btn.disabled = true;
                btn.textContent = '💡 已用盡';
            } else {
                btn.disabled = false;
                btn.textContent = '💡 提示 (-10分)';
            }
        }

        function updateDisplay() {
            document.getElementById('scoreDisplay').textContent = gameState.score;
            document.getElementById('correctDisplay').textContent = gameState.correct;
        }

        function nextRound() {
            document.getElementById('resultScreen').classList.remove('show');
            gameState.round++;
            loadRound();
        }

        function showFinal() {
            const screen = document.getElementById('finalScreen');
            const badge = document.getElementById('rankBadge');
            const msg = document.getElementById('finalMsg');
            
            document.getElementById('finalScore').textContent = gameState.score;
            document.getElementById('finalCorrect').textContent = gameState.correct;
            
            if (gameState.correct >= 10) {
                badge.className = 'rank-badge gold';
                badge.innerHTML = `<svg width="45" height="45" viewBox="0 0 50 50"><polygon points="25,5 30,18 45,18 33,27 38,42 25,33 12,42 17,27 5,18 20,18" fill="#FFD700"/></svg>`;
                msg.innerHTML = '👑 <strong>讀心王者</strong>！';
            } else if (gameState.correct >= 7) {
                badge.className = 'rank-badge silver';
                badge.innerHTML = `<svg width="45" height="45" viewBox="0 0 50 50"><polygon points="25,8 29,19 42,19 32,27 36,40 25,32 14,40 18,27 8,19 21,19" fill="#C0C0C0"/></svg>`;
                msg.innerHTML = '⭐ <strong>觀察達人</strong>！';
            } else if (gameState.correct >= 4) {
                badge.className = 'rank-badge bronze';
                badge.innerHTML = `<svg width="45" height="45" viewBox="0 0 50 50"><circle cx="25" cy="25" r="18" fill="#CD7F32"/></svg>`;
                msg.innerHTML = '繼續加油！';
            } else {
                badge.className = 'rank-badge iron';
                badge.innerHTML = `<svg width="45" height="45" viewBox="0 0 50 50"><circle cx="25" cy="25" r="18" fill="#808080"/></svg>`;
                msg.innerHTML = '😵 需要練習眼力！';
            }
            
            screen.classList.add('show');
        }

        function startGame() {
            document.getElementById('startScreen').classList.add('hide');
            initGame();
            loadRound();
        }

        function restartGame() {
            gameState = { score: 0, round: 0, correct: 0, hintLevel: 0, currentChar: null, questions: [] };
            document.getElementById('finalScreen').classList.remove('show');
            updateDisplay();
            initGame();
            loadRound();
        }

        document.getElementById('startIcon').innerHTML = `
            <svg width="120" height="100" viewBox="0 0 120 100">
                <ellipse cx="60" cy="50" rx="45" ry="48" fill="#FFF5F0" stroke="#333" stroke-width="2"/>
                <ellipse cx="60" cy="35" rx="48" ry="35" fill="#1a1a1a" stroke="#333" stroke-width="2"/>
                <path d="M15 50 Q35 20 60 18 Q85 20 105 50 Q80 65 60 62 Q40 65 15 50" fill="#1a1a1a" stroke="#333" stroke-width="2"/>
                
                <!-- 耳朵 -->
                <ellipse cx="15" cy="50" rx="5" ry="10" fill="#FFF5F0" stroke="#333" stroke-width="1.5"/>
                <ellipse cx="105" cy="50" rx="5" ry="10" fill="#FFF5F0" stroke="#333" stroke-width="1.5"/>
                
                <ellipse cx="42" cy="48" rx="12" ry="14" fill="white" stroke="#333" stroke-width="1.5"/>
                <circle cx="43" cy="50" r="7" fill="#8B7355"/>
                <circle cx="43" cy="52" r="4" fill="#4a3520"/>
                <circle cx="40" cy="46" r="4" fill="white"/>
                <ellipse cx="78" cy="48" rx="12" ry="14" fill="white" stroke="#333" stroke-width="1.5"/>
                <circle cx="77" cy="50" r="7" fill="#8B7355"/>
                <circle cx="77" cy="52" r="4" fill="#4a3520"/>
                <circle cx="74" cy="46" r="4" fill="white"/>
                <ellipse cx="32" cy="62" rx="10" ry="4" fill="#FF8888" opacity="0.4"/>
                <ellipse cx="88" cy="62" rx="10" ry="4" fill="#FF8888" opacity="0.4"/>
                
                <!-- 耳掛繩到耳朵 -->
                <path d="M25 65 Q18 60 15 50" stroke="#87CEEB" stroke-width="3" fill="none" stroke-linecap="round"/>
                <path d="M95 65 Q102 60 105 50" stroke="#87CEEB" stroke-width="3" fill="none" stroke-linecap="round"/>
                
                <!-- 口罩 -->
                <path d="M25 63 Q30 58 60 55 Q90 58 95 63 L97 78 Q98 90 60 95 Q22 90 23 78 Z" fill="#F8FAFC" stroke="#ccc" stroke-width="1.5"/>
                <text x="60" y="78" text-anchor="middle" font-size="16" fill="#aaa">?</text>
                
                <g transform="translate(82, 60) scale(0.7)">
                    <path d="M0 4 Q0 0 4 0 Q8 0 8 4 Q8 8 4 12 Q0 8 0 4" fill="#E57373"/>
                    <path d="M8 4 Q8 0 12 0 Q16 0 16 4 Q16 8 12 12 Q8 8 8 4" fill="#EF5350"/>
                </g>
            </svg>
        `;
    </script>
</body>
</html>
